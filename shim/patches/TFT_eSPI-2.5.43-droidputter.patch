 #if defined (ILI9225_DRIVER)
   if (rotation & 0x01) { transpose(x0, y0); transpose(x1, y1); }
@@ -3586,6 +3591,9 @@
 
   // Range checking
   if ((x < _vpX) || (y < _vpY) ||(x >= _vpW) || (y >= _vpH)) return;
+#if defined (DROIDPUTTER_VIRTUAL) && DPT_MODE == 1
