+#endif
 
 #ifdef CGRAM_OFFSET
   x+=colstart;
@@ -5942,7 +5950,11 @@
 #if !defined (TFT_PARALLEL_8_BIT) && !defined (RP2040_PIO_INTERFACE)
 SPIClass& TFT_eSPI::getSPIinstance(void)
 {
